
<configuration>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/game.log</file>
        <encoder>
            <pattern>%-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="FILE" />
    </root>
</configuration>